{"seq": 116, "ts": "2026-08-02T18:05:25Z", "op": "upsert", "record_id": "REQ-027", "record": {"id": "REQ-027", "kind": "requirement", "status": "active", "label": "Pseudonymous maintainer identity", "confidence": 0.7, "source_type": "observed", "evidence": ["synced from requirements.json"], "epistemic_boundary": [], "is_hypothesis": false, "model_assumptions": {}, "recursion_depth": 0, "data": {"id": "REQ-027", "version": 1, "title": "Pseudonymous maintainer identity", "description": "Project-authored public commits and annotated release tags use VaMender <vamender@users.noreply.github.com> rather than a maintainer's legal name, personal account name, or personal email. Repository-local configuration, a pre-push guard, CI, and release gates verify the metadata. Maintainers push through a separate pseudonymous GitHub account or GitHub App because commit metadata cannot conceal GitHub's authenticated event actor.", "source": "AGENTS.md; MAINTAINERS.md; tools/configure-maintainer-identity.ps1; tools/check-maintainer-identity.ps1; .githooks/pre-push; .github/workflows/ci.yml; .github/workflows/release.yml", "status": "implemented", "test_ids": ["TEST-027"]}}, "prev_hash": "78f66852743da30669cb0ef608a44f0baada776ab07be6accf7e54aac50c8e22", "hash": "d141c3e8560695490f58b41ec460f168d8e6196755e2db1682e67dbb438bda2f", "recursion_depth": 0}
