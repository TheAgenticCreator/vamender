{"seq": 118, "ts": "2026-08-02T18:28:07Z", "op": "upsert", "record_id": "REQ-028", "record": {"id": "REQ-028", "kind": "requirement", "status": "active", "label": "Windows tray-host lifecycle", "confidence": 0.7, "source_type": "observed", "evidence": ["synced from requirements.json"], "epistemic_boundary": [], "is_hypothesis": false, "model_assumptions": {}, "recursion_depth": 0, "data": {"id": "REQ-028", "version": 1, "title": "Windows tray-host lifecycle", "description": "The per-user Windows host presents a VaMender notification-area icon, starts the constrained engine without a console or external script, keeps it available across ordinary VaM launches, launches VaM on request, opens report and backup folders, reports product/version and safety information, toggles Start with Windows, and exits cooperatively after any in-flight operation finishes. Setup enables Start with Windows by default, and VaM's plugin sandbox is not used to spawn or terminate the host.", "source": "src/app/tray_host.rs; src/app/bridge.rs; src/app/host_install.rs; README.md", "status": "implemented", "test_ids": ["TEST-028"]}}, "prev_hash": "c86205f305fe47084fe435f0af004ec7a097c7a600dd32c0ebc4c5fd4718687a", "hash": "20f137a111b0862e444a306073f74f28efc93d241cefb1c75ed422b4e40609fa", "recursion_depth": 0}
